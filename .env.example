# Copy to .env.local and fill in real values. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3210

# openssl rand -hex 32
SESSION_SECRET=
CSRF_SECRET=
PAYMENT_WEBHOOK_SECRET=

ADMIN_EMAIL=owner@losk.ru
ADMIN_PASSWORD=

# Optional: leave empty to auto-generate + persist in data/secrets.json
VAPID_SUBJECT=mailto:owner@losk.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

PAYMENT_PROVIDER=sandbox

# 1 = demo mode (auto-seed, one-click cabinet entry, reset button).
# Set to 0 in production, otherwise any visitor can open the owner cabinet.
DEMO_MODE=1
